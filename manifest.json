{
  "manifest_version": 3,
  "name": "Q-Hider",
  "version": "0.1.0",
  "minimum_chrome_version": "95",
  "description": "traQの気になる表示を項目ごとに安全に隠します。",
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["https://q.trap.jp/*"],
      "js": ["core.js", "detector.js", "app.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
